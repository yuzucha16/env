[
  { "key": "space f f", "command": "workbench.action.quickOpen", "when": "editorTextFocus" },                         // <leader>ff: ファイル検索
  { "key": "space f g", "command": "workbench.action.findInFiles", "when": "editorTextFocus" },                        // <leader>fg: ripgrep
  { "key": "space f b", "command": "workbench.action.showAllEditors", "when": "editorTextFocus" },                     // <leader>fb: バッファ一覧
  { "key": "space f s", "command": "workbench.action.gotoSymbol", "when": "editorTextFocus" },                          // <leader>fs: Doc symbols
  { "key": "space f S", "command": "workbench.action.showAllSymbols", "when": "editorTextFocus" },                      // <leader>fS: WS symbols
  { "key": "space e",   "command": "workbench.view.explorer", "when": "editorTextFocus" },                              // <leader>e: ファイラ

  { "key": "space w w", "command": "workbench.action.files.save", "when": "editorTextFocus" },                          // <leader>ww
  { "key": "space q q", "command": "workbench.action.closeActiveEditor", "when": "editorTextFocus" },                   // <leader>qq

  { "key": "g d", "command": "editor.action.revealDefinition", "when": "editorHasDefinitionProvider && editorTextFocus" },        // gd
  { "key": "g r", "command": "editor.action.referenceSearch.trigger", "when": "editorHasReferenceProvider && editorTextFocus" },   // gr
  { "key": "g i", "command": "editor.action.goToImplementation", "when": "editorHasImplementationProvider && editorTextFocus" },   // gI
  { "key": "k",   "command": "editor.action.showHover", "when": "editorTextFocus && vim.mode == 'Normal'" },                        // K
  { "key": "space r n", "command": "editor.action.rename", "when": "editorHasRenameProvider && editorTextFocus" },                  // <leader>rn
  { "key": "space c a", "command": "editor.action.codeAction", "when": "editorHasCodeActionsProvider && editorTextFocus" },         // <leader>ca

  { "key": "[ d", "command": "editor.action.marker.prev", "when": "editorTextFocus" },                                             // [d
  { "key": "] d", "command": "editor.action.marker.next", "when": "editorTextFocus" },                                             // ]d
  { "key": "space g l", "command": "workbench.actions.view.problems", "when": "editorTextFocus" },                                 // gl: Problems を開く

  { "key": "space 1", "command": "workbench.action.openEditorAtIndex1" },
  { "key": "space 2", "command": "workbench.action.openEditorAtIndex2" },
  { "key": "space 3", "command": "workbench.action.openEditorAtIndex3" },
  { "key": "space h", "command": "workbench.action.previousEditor" },
  { "key": "space l", "command": "workbench.action.nextEditor" },
  { "key": "space b d", "command": "workbench.action.closeActiveEditor" }
]
